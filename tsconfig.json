{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "types": ["bun","vite/client"],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "server", "scripts", "tests", "playwright.config.ts"]
}
